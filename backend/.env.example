PORT=4000
# mock | sensibull | none  (none = only manual POST /api/snapshot)
PROVIDER=sensibull
# instruments to poll, comma separated
SYMBOLS=NIFTY
# OI poll (Sensibull), minutes
POLL_MINUTES=3
# spot + strike premiums (Kite), seconds
PRICE_SECONDS=60
# 1 = poll even outside 09:15-15:30 IST (useful for testing)
FORCE_MARKET_OPEN=0

# Sensibull: no secrets here — paste the day's curl on the dashboard's "Sensibull Session" page.
# Strikes around ATM requested from Sensibull: ten | twenty | all
SENSIBULL_STRIKES=ten
